# ── Required ────────────────────────────────────────────────────────────────

# Your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Signs family sign-in cookies. REQUIRED in production - use a long random
# string (e.g. `openssl rand -hex 32`). A dev fallback is used locally.
COOKIE_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Port for the Express server (default 3001)
PORT=3001

# Tutoring model (default claude-opus-5). claude-sonnet-5 is the budget option.
# Needs a current-generation model (supports output_config.effort).
CLAUDE_MODEL=

# Reasoning effort for chat: low keeps replies snappy (default), raise to
# medium/high if you want deeper reasoning at some latency cost.
CLAUDE_EFFORT=

# Where the SQLite database lives (default ./data/homework-coach.db).
# On Railway, mount a volume and point this at it, e.g. /data/homework-coach.db
DATABASE_PATH=

# Per-family daily token budget across chat + practice (default 300000,
# roughly a hundred generous exchanges).
DAILY_TOKEN_BUDGET=

# Comma-separated origins allowed to call the API cross-origin.
# Not needed in production (the server serves the client from the same origin).
# Default in development: http://localhost:3000
CORS_ORIGIN=

# Structured log level: trace | debug | info | warn | error (default info)
LOG_LEVEL=

# Optional error tracking: set a Sentry DSN to enable @sentry/node
SENTRY_DSN=

# ── Weekly email digest (optional) ──────────────────────────────────────────
# Leave unset to disable email sending entirely - parents can still preview
# the digest in the dashboard. Sent Sundays from 17:00 UTC to each family that
# saved a digest email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
